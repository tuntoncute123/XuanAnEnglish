# PostgreSQL connection URL. Use Coolify's internal database URL in production.
DATABASE_URL=postgres://user:password@localhost:5432/xuananenglish
# Required: at least 12 characters.
ADMIN_PASSWORD=change-this-password
# Required in production. Generate with: openssl rand -hex 48
SESSION_SECRET=replace-with-a-random-secret
# Optional: Web Push VAPID keys (auto-generated and persisted in PostgreSQL if omitted)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@xuananenglish.local
# Optional: Secret token for scheduled reminder cron (GET/POST /api/cron/reminders)
# CRON_SECRET=
# Optional: persistent directory for uploaded files; defaults to ./data
# DATA_DIR=/app/data
# Optional demo records for local development only
# SEED_DEMO_DATA=true
# When the frontend is on Vercel and API is on Coolify
# FRONTEND_ORIGIN=https://xuan-an-english.vercel.app
